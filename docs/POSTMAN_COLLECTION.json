				}
			],
			"description": "File upload and management operations. All endpoints require authentication."
		},
		{
			"name": "Public Files",
			"item": [
				{
					"name": "Access File (Public)",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/files/{{fileId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"files",
								"{{fileId}}"
							]
						},
						"description": "Public endpoint to access files. **No authentication required.**\n\nSupports Range requests for video streaming and partial content delivery.\n\n### Path Parameters\n\n- `id`: Google Drive file ID\n\n### Headers (Optional)\n\n- `Range`: Byte range for partial content (e.g., `bytes=0-1023`)\n\n### Response\n\nReturns the file content with appropriate headers:\n\n- `Content-Type`: File's MIME type\n- `Content-Length`: File size\n- `Accept-Ranges`: bytes\n- `Cache-Control`: Caching directives\n\n### Video Streaming Example\n\n```bash\ncurl -H \"Range: bytes=0-1048575\" \\\n  https://your-worker.workers.dev/files/1abc123xyz\n```"
					},
					"response": [
						{
							"name": "Success - Full Content",
							"originalRequest": {
								"method": "GET",
								"header": [],
								"url": {
									"raw": "{{baseUrl}}/files/1abc123xyz",
									"host": [
										"{{baseUrl}}"
									],
									"path": [
										"files",
										"1abc123xyz"
									]
								}
							},
							"status": "OK",
							"code": 200,
							"_postman_previewlanguage": "plain",
							"header": [
								{
									"key": "Content-Type",
									"value": "image/jpeg"
								},
								{
									"key": "Content-Length",
									"value": "524288"
								},
								{
									"key": "Accept-Ranges",
									"value": "bytes"
								}
							],
							"body": "[Binary file content]"
						},
						{
							"name": "Success - Partial Content (Range)",
							"originalRequest": {
								"method": "GET",
								"header": [
									{
										"key": "Range",
										"value": "bytes=0-1023"
									}
								],
								"url": {
									"raw": "{{baseUrl}}/files/1abc123xyz",
									"host": [
										"{{baseUrl}}"
									],
									"path": [
										"files",
										"1abc123xyz"
									]
								}
							},
							"status": "Partial Content",
							"code": 206,
							"_postman_previewlanguage": "plain",
							"header": [
								{
									"key": "Content-Type",
									"value": "video/mp4"
								},
								{
									"key": "Content-Range",
									"value": "bytes 0-1023/104857600"
								},
								{
									"key": "Content-Length",
									"value": "1024"
								}
							],
							"body": "[Partial binary content]"
