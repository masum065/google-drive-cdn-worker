									"        console.log('File Name:', response.data.name);",
									"        console.log('MIME Type:', response.data.mimeType);",
									"        console.log('Size:', response.data.size);",
									"        console.log('CDN URL:', response.data.rawUrl);",
									"    }",
									"}"
								],
