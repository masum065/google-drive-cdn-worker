							"body": "{\n    \"status\": \"success\",\n    \"data\": {\n        \"id\": \"1abc123xyz\",\n        \"name\": \"my-image.jpg\",\n        \"size\": \"524288\",\n        \"mimeType\": \"image/jpeg\",\n        \"rawUrl\": \"https://your-worker.workers.dev/files/1abc123xyz\"\n    }\n}"
						}
					]
				},
